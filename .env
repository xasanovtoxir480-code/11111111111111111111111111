DATABASE_URL=file:/home/z/my-project/db/custom.db

# ============ Google OAuth Sozlamalari ============
# Google Cloud Console -> APIs & Services -> Credentials dan oling:
# https://console.cloud.google.com/apis/credentials
#
# 1. "OAuth 2.0 Client IDs" -> "Web application" yarating
# 2. Authorized redirect URIs ga quyidagi URL ni qo'shing:
#    http://localhost:3000/api/auth/google/callback
# 3. Client ID va Client Secret ni quyiga joylashtiring
# ================================================

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
